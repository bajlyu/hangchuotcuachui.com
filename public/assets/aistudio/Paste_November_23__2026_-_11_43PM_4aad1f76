  <link href="https://fonts.googleapis.com/css2?family=Alata&amp;family=Instrument+Sans:wght@400;500;600;700&amp;family=Source+Code+Pro:wght@400;500&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block" rel="stylesheet">
  <style>
    .material-symbols-outlined {
      display: inline-block;
      width: 1em;
      height: 1em;
      line-height: 1 !important;
      box-sizing: content-box;
      overflow: hidden;
      white-space: nowrap;
      direction: ltr;
      vertical-align: middle;
    }

    /* ==================== Morph Transition: Template 1 <-> Template 2 ==================== */
    .morph-stage {
      position: relative;
      overflow-x: hidden;
    }
    .template-layer {
      transition:
        transform 750ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 600ms cubic-bezier(0.22, 1, 0.36, 1),
        filter 650ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform, opacity, filter;
    }
    .stage-t1 #template-1 {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0px);
      pointer-events: auto;
      position: relative;
      z-index: 20;
    }
    .stage-t1 #template-2 {
      opacity: 0;
      transform: scale(1.05) translateY(40px);
      filter: blur(10px);
      pointer-events: none;
      position: absolute;
      inset: 0;
      z-index: 10;
    }
    .stage-t2 #template-1 {
      opacity: 0;
      transform: scale(0.86) translateY(-48px);
      filter: blur(12px);
      pointer-events: none;
      position: absolute;
      inset: 0;
      z-index: 10;
    }
    .stage-t2 #template-2 {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0px);
      pointer-events: auto;
      position: relative;
      z-index: 20;
    }
    .hero-wordmark {
      transition: transform 750ms cubic-bezier(0.22, 1, 0.36, 1), letter-spacing 750ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .stage-t2 .hero-wordmark {
      transform: scale(0.65) translateY(-80px);
      letter-spacing: 0.08em;
    }

    /* ==================== DriftWall 3D Engine ==================== */
    .driftwall-viewport {
      position: relative;
      height: 640px;
      width: 100%;
      overflow: hidden;
      perspective: 1700px;
      perspective-origin: 50% 50%;
      mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%);
    }
    .driftwall-plane {
      position: absolute;
      inset: -140px -120px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 28px;
      transform-style: preserve-3d;
      transform: rotateX(16deg) rotateY(-28deg);
      transition: transform 180ms ease-out;
    }
    .driftwall-col {
      display: flex;
      flex-direction: column;
      gap: 28px;
      width: 180px;
      flex-shrink: 0;
      transform-style: preserve-3d;
      will-change: transform;
    }
    .driftwall-tile {
      position: relative;
      width: 180px;
      height: 262px;
      border-radius: 16px;
      overflow: hidden;
      flex-shrink: 0;
      cursor: pointer;
      transform-style: preserve-3d;
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 320ms ease-out;
      box-shadow: 0 14px 28px rgba(105, 0, 85, 0.22);
    }
    .driftwall-tile img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(100%) brightness(0.78);
      transition: filter 320ms ease-out, transform 320ms ease-out;
    }
    .driftwall-tile .tile-overlay {
      position: absolute;
      inset: 0;
      background-color: #690055;
      opacity: 0.45;
      mix-blend-mode: multiply;
      transition: opacity 320ms ease-out;
    }
    .driftwall-tile:hover {
      transform: translateZ(64px) scale(1.06);
      box-shadow: 0 24px 44px rgba(105, 0, 85, 0.4);
      z-index: 30;
    }
    .driftwall-tile:hover img {
      filter: grayscale(0%) brightness(1);
    }
    .driftwall-tile:hover .tile-overlay {
      opacity: 0.08;
    }

    /* ==================== LineSidebar Tag Selector ==================== */
    .line-sidebar-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
      position: relative;
    }
    .line-sidebar-item {
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      color: #f0ffd5;
      font-size: 1.1rem;
      line-height: 1.3;
      padding: 4px 0;
      text-align: left;
      background: transparent;
      border: 0;
      transition: transform 100ms cubic-bezier(0.22, 1, 0.36, 1), color 180ms ease-out;
      will-change: transform;
    }
    .line-sidebar-tick {
      display: inline-block;
      width: 18px;
      height: 2px;
      background-color: rgba(240, 255, 213, 0.32);
      transform-origin: left center;
      transform: scaleX(0.5);
      transition: transform 100ms cubic-bezier(0.22, 1, 0.36, 1), width 180ms ease-out, background-color 180ms ease-out;
      flex-shrink: 0;
    }
    .line-sidebar-index {
      font-family: 'Source Code Pro', monospace;
      font-size: 0.78rem;
      opacity: 0.55;
      letter-spacing: 0.04em;
      flex-shrink: 0;
      transition: color 180ms ease-out, opacity 180ms ease-out;
    }
    .line-sidebar-label {
      font-family: 'Instrument Sans', sans-serif;
      font-weight: 500;
      white-space: nowrap;
      transition: color 180ms ease-out, font-weight 180ms ease-out;
    }
    .line-sidebar-item.is-active .line-sidebar-tick {
      width: 60px;
      transform: scaleX(1) !important;
      background-color: #99b966;
    }
    .line-sidebar-item.is-active .line-sidebar-index {
      color: #99b966;
      opacity: 1;
    }
    .line-sidebar-item.is-active .line-sidebar-label {
      color: #f0ffd5;
      font-weight: 700;
      text-shadow: 0 0 18px rgba(155, 24, 89, 0.65);
    }
    .line-sidebar-item.is-active {
      border-left: 3px solid #9b1859;
      padding-left: 10px;
    }

    /* ==================== CurvedLoop Author Marquee ==================== */
    .curved-loop-mask {
      mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.45) 10%, black 22%, black 78%, rgba(0, 0, 0, 0.45) 90%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.45) 10%, black 22%, black 78%, rgba(0, 0, 0, 0.45) 90%, transparent 100%);
    }
    .curved-author-tspan {
      cursor: pointer;
      transition: fill 180ms ease-out, opacity 180ms ease-out;
    }
    .curved-author-tspan:hover {
      fill: #F49AC1;
    }

    /* ==================== 3D FlipCard inside Book Detail Modal ==================== */
    .flip-card-scene {
      perspective: 1100px;
      width: 280px;
      height: 380px;
    }
    .flip-card-tilt {
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .flip-card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transform-style: preserve-3d;
      transition: transform 650ms cubic-bezier(0.18, 0.89, 0.32, 1.15);
      border-radius: 22px;
      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
      cursor: pointer;
    }
    .flip-card-scene.is-flipped .flip-card-inner,
    .flip-card-scene.hover-flip:hover .flip-card-inner {
      transform: rotateY(180deg);
    }
    .flip-card-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: 22px;
      overflow: hidden;
    }
    .flip-card-back {
      transform: rotateY(180deg);
      background-color: #27272a;
      color: #f5f5f5;
    }
    .flip-card-glare {
      position: absolute;
      inset: 0;
      pointer-events: none;
      border-radius: 22px;
      opacity: 0;
      transition: opacity 200ms ease-out;
      background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 65%);
      z-index: 15;
    }
    .flip-card-scene:hover .flip-card-glare {
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .template-layer, .hero-wordmark, .driftwall-tile, .driftwall-plane {
        transition: none !important;
      }
    }
  </style>
</head>
<body class="bg-light-surface-bright text-light-on-surface font-body antialiased selection:bg-kale-pink selection:text-light-primary">

