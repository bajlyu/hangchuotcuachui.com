      ];

      function loadBooks() {
        try {
          const raw = localStorage.getItem('hang_chuot_chui_books_v2');
          if (raw) return JSON.parse(raw);
        } catch (err) {}
        return DEFAULT_BOOKS.slice();
      }
      function saveBooks(list) {
        try { localStorage.setItem('hang_chuot_chui_books_v2', JSON.stringify(list)); } catch (err) {}
      }

      let books = loadBooks();
      let driftBaseSpeed = 60;
      let currentTag = 'Tất cả';

      const STATUS_META = {
        want: { label: 'Muốn đọc', badgeClass: 'bg-light-secondary-container text-light-on-secondary-container' },
        reading: { label: 'Đang đọc', badgeClass: 'bg-light-tertiary-container text-light-on-tertiary-container' },
        done: { label: 'Đã xong', badgeClass: 'bg-light-primary text-light-on-primary' }
      };

      // ==================== 1. Morph Transition (Template 1 <-> Template 2) ====================
      const stage = document.getElementById('morph-stage');
      function goToTemplate2() {
        stage.classList.remove('stage-t1');
        stage.classList.add('stage-t2');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      function goToTemplate1() {
        stage.classList.remove('stage-t2');
        stage.classList.add('stage-t1');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      document.getElementById('enter-burrow-btn').addEventListener('click', goToTemplate2);
      document.getElementById('scroll-morph-cue').addEventListener('click', goToTemplate2);
      document.getElementById('back-to-hero-btn').addEventListener('click', goToTemplate1);

      window.addEventListener('wheel', function (e) {
        if (stage.classList.contains('stage-t1') && e.deltaY > 36) goToTemplate2();
      }, { passive: true });

      // ==================== 2. DriftWall 3D Engine ====================
      const driftPlane = document.getElementById('tusach-driftwall-plane');
      const driftViewport = document.getElementById('tusach-driftwall-viewport');
      let colStates = [];

      function renderDriftPool(pool, badgeLabel, countNum) {
        const countEl = document.getElementById('active-tag-count');
        if (countEl) countEl.textContent = countNum + ' cuốn';
        const badgeEl = document.getElementById('driftwall-tag-badge');
        if (badgeEl) {
          const spanText = badgeEl.querySelector('span:last-child');
          if (spanText) spanText.textContent = badgeLabel;
        }
        driftPlane.innerHTML = '';
        colStates = [];
        for (let c = 0; c < 7; c++) {
          const colEl = document.createElement('div');
          colEl.className = 'driftwall-col';
          const colBooks = [];
          for (let i = 0; i < 6; i++) {
            colBooks.push(pool[(c * 2 + i) % pool.length]);
          }
          colBooks.concat(colBooks).forEach(function (book) {
            const tile = document.createElement('div');
            tile.className = 'driftwall-tile';
            tile.innerHTML = '<img src="' + book.image + '" alt="' + book.title + '" /><div class="tile-overlay"></div>';
            tile.addEventListener('click', function () { openBookDetail(book.id); });
            colEl.appendChild(tile);
          });
          driftPlane.appendChild(colEl);
          const factor = 1 + ((c % 2 === 0 ? 1 : -1) * 0.55 * 0.35) + (c * 0.08);
          const loopHeight = colBooks.length * (262 + 28);
          colStates.push({ el: colEl, offset: (c * 85) % loopHeight, factor: factor, loopHeight: loopHeight, depthZ: (c - 3) * 22 });
        }
      }

      function rebuildDriftWall(tag) {
        currentTag = tag || 'Tất cả';
        const filtered = currentTag === 'Tất cả'
          ? books
          : books.filter(function (b) { return (b.genre || '').toLowerCase() === currentTag.toLowerCase(); });
        const pool = filtered.length > 0 ? filtered : books;
        renderDriftPool(pool, 'Dòng sách đang chạy · ' + currentTag, filtered.length);
      }
      rebuildDriftWall('Tất cả');

      let lastT = performance.now();
      let driftPaused = false;
      driftViewport.addEventListener('mouseenter', function () { driftPaused = true; });
      driftViewport.addEventListener('mouseleave', function () {
        driftPaused = false;
        driftPlane.style.transform = 'rotateX(16deg) rotateY(-28deg)';
      });
      driftViewport.addEventListener('mousemove', function (e) {
        const rect = driftViewport.getBoundingClientRect();
        const nx = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        const ny = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        driftPlane.style.transform = 'rotateX(' + (16 - ny * 5).toFixed(1) + 'deg) rotateY(' + (-28 + nx * 7).toFixed(1) + 'deg)';
      });
      function driftTick(now) {
        const dt = Math.min((now - lastT) / 1000, 0.05);
        lastT = now;
        const mult = driftPaused ? 0.15 : 1;
        for (let i = 0; i < colStates.length; i++) {
          const st = colStates[i];
          st.offset = (st.offset + driftBaseSpeed * st.factor * mult * dt) % st.loopHeight;
          st.el.style.transform = 'translate3d(0, -' + st.offset.toFixed(1) + 'px, ' + st.depthZ + 'px)';
        }
        requestAnimationFrame(driftTick);
      }
      requestAnimationFrame(driftTick);

      // ==================== 3. LineSidebar Tag Selector ====================
      const TAG_ITEMS = ['Tất cả', 'Tiểu thuyết', 'Văn học Việt', 'Triết lý', 'Giả tưởng', 'Lãng mạn', 'Phiêu lưu'];
      const sidebarNav = document.getElementById('line-sidebar-nav');
      let activeTagIndex = 0;

      TAG_ITEMS.forEach(function (label, idx) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'line-sidebar-item' + (idx === activeTagIndex ? ' is-active' : '');
        btn.innerHTML =
          '<span class="line-sidebar-tick" aria-hidden="true"></span>' +
          '<span class="line-sidebar-index">0' + (idx + 1) + '</span>' +
          '<span class="line-sidebar-label">' + label + '</span>';
        btn.addEventListener('click', function () {
          activeTagIndex = idx;
          sidebarNav.querySelectorAll('.line-sidebar-item').forEach(function (el, i) {
            el.classList.toggle('is-active', i === activeTagIndex);
          });
          document.getElementById('reset-author-filter-btn').classList.add('hidden');
          document.getElementById('author-books-panel').classList.add('hidden');
          rebuildDriftWall(label);
        });
        sidebarNav.appendChild(btn);
      });

      sidebarNav.addEventListener('mousemove', function (e) {
        sidebarNav.querySelectorAll('.line-sidebar-item').forEach(function (item) {
          const rect = item.getBoundingClientRect();
          const dist = Math.abs(e.clientY - (rect.top + rect.height / 2));
          const t = dist < 100 ? 0.5 * (1 + Math.cos(Math.PI * (dist / 100))) : 0;
          item.style.transform = 'translateX(' + (t * 30).toFixed(1) + 'px)';
          const tick = item.querySelector('.line-sidebar-tick');
          if (tick && !item.classList.contains('is-active')) {
            tick.style.transform = 'scaleX(' + (0.5 + t * 0.5).toFixed(2) + ')';
          }
        });
      });
      sidebarNav.addEventListener('mouseleave', function () {
        sidebarNav.querySelectorAll('.line-sidebar-item').forEach(function (item) {
          item.style.transform = 'translateX(0px)';
          const tick = item.querySelector('.line-sidebar-tick');
          if (tick && !item.classList.contains('is-active')) {
            tick.style.transform = 'scaleX(0.5)';
          }
        });
      });

      // ==================== 4. Search Bar ====================
      const searchInputEl = document.getElementById('search-books-input');
      const searchResultsEl = document.getElementById('tusach-search-results');
      const clearSearchBtn = document.getElementById('clear-search-btn');

      function renderSearchDropdown(q) {
        const trimmed = (q || '').trim().toLowerCase();
        if (!trimmed) {
          searchResultsEl.classList.add('hidden');
          searchResultsEl.innerHTML = '';
          clearSearchBtn.classList.add('hidden');
          return;
        }
        clearSearchBtn.classList.remove('hidden');
        const matches = books.filter(function (b) {
          return b.title.toLowerCase().indexOf(trimmed) !== -1 || b.author.toLowerCase().indexOf(trimmed) !== -1;
        });
        if (!matches.length) {
          searchResultsEl.innerHTML = '<div class="px-gutter-md py-4 font-body text-body-md text-light-on-surface-variant">Không tìm thấy truyện hoặc tác giả phù hợp.</div>';
          searchResultsEl.classList.remove('hidden');
          return;
        }
        searchResultsEl.innerHTML = matches.slice(0, 6).map(function (b) {
          const meta = STATUS_META[b.status] || STATUS_META.want;
          return '<button type="button" data-search-book="' + b.id + '" class="w-full flex items-center justify-between gap-gutter-md px-gutter-md py-3 hover:bg-light-surface-container transition-colors border-b border-light-outline-variant last:border-b-0 text-left">' +
            '<div class="flex items-center gap-gutter-md min-w-0">' +
              '<img src="' + b.image + '" alt="' + b.title + '" class="w-10 h-14 object-cover rounded-md flex-shrink-0" />' +
              '<div class="min-w-0">' +
                '<div class="font-title text-title-sm text-light-on-surface truncate">' + b.title + '</div>' +
                '<div class="font-body text-body-sm text-light-on-surface-variant truncate">' + b.author + '</div>' +
              '</div>' +
            '</div>' +
            '<span class="flex-shrink-0 inline-flex items-center px-2.5 py-1 rounded-full font-label text-label-sm ' + meta.badgeClass + '">' + meta.label + '</span>' +
          '</button>';
        }).join('');
        searchResultsEl.classList.remove('hidden');
        searchResultsEl.querySelectorAll('[data-search-book]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            searchResultsEl.classList.add('hidden');
            openBookDetail(btn.getAttribute('data-search-book'));
          });
        });
      }
      searchInputEl.addEventListener('input', function (e) { renderSearchDropdown(e.target.value); });
      clearSearchBtn.addEventListener('click', function () {
        searchInputEl.value = '';
        renderSearchDropdown('');
        searchInputEl.focus();
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest('#tusach-search-section')) searchResultsEl.classList.add('hidden');
      });

      // ==================== 5. CurvedLoop Author Marquee ====================
      const curvedTextPath = document.getElementById('curved-loop-textpath');
      const curvedWrapper = document.getElementById('curved-loop-wrapper');
      const authorPanel = document.getElementById('author-books-panel');
      const authorHeading = document.getElementById('author-books-heading');
      const authorCount = document.getElementById('author-books-count');
      const authorList = document.getElementById('author-books-list');
      const resetAuthorBtn = document.getElementById('reset-author-filter-btn');
      const resetAuthorLabel = document.getElementById('reset-author-label');

      function selectAuthorFromLoop(authorName) {
        const matched = books.filter(function (b) { return (b.author || '').toLowerCase() === authorName.toLowerCase(); });
        authorHeading.textContent = 'Tác phẩm của ' + authorName;
        authorCount.textContent = matched.length + ' cuốn';
        authorList.innerHTML = matched.map(function (b) {
          const meta = STATUS_META[b.status] || STATUS_META.want;
          return '<button type="button" data-author-book="' + b.id + '" class="flex items-center gap-gutter-md p-gutter-md rounded-lg bg-dark-surface-container border border-dark-outline-variant hover:border-kale-pink transition-colors text-left">' +
            '<img src="' + b.image + '" alt="' + b.title + '" class="w-14 h-20 object-cover rounded-md flex-shrink-0" />' +
            '<div class="min-w-0 flex-1 flex flex-col gap-1">' +
              '<div class="flex items-center justify-between gap-2">' +
                '<span class="font-title text-title-sm text-light-surface-bright truncate">' + b.title + '</span>' +
                '<span class="px-2 py-0.5 rounded-full font-label text-[11px] flex-shrink-0 ' + meta.badgeClass + '">' + meta.label + '</span>' +
              '</div>' +
              '<p class="font-body text-body-sm text-dark-on-surface-variant line-clamp-2">' + (b.synopsis || '') + '</p>' +
            '</div>' +
          '</button>';
        }).join('');
        authorList.querySelectorAll('[data-author-book]').forEach(function (cardBtn) {
          cardBtn.addEventListener('click', function () { openBookDetail(cardBtn.getAttribute('data-author-book')); });
        });
        authorPanel.classList.remove('hidden');
        resetAuthorLabel.textContent = authorName + ' · Bỏ lọc';
        resetAuthorBtn.classList.remove('hidden');
        renderDriftPool(matched.length > 0 ? matched : books, 'Tác giả · ' + authorName, matched.length);
      }

      resetAuthorBtn.addEventListener('click', function () {
        resetAuthorBtn.classList.add('hidden');
        authorPanel.classList.add('hidden');
        rebuildDriftWall(currentTag);
      });

      const SVG_NS = 'http://www.w3.org/2000/svg';
      const uniqueAuthors = [];
      books.forEach(function (b) { if (b.author && uniqueAuthors.indexOf(b.author) === -1) uniqueAuthors.push(b.author); });
      uniqueAuthors.concat(uniqueAuthors).concat(uniqueAuthors).forEach(function (author) {
        const tspan = document.createElementNS(SVG_NS, 'tspan');
        tspan.textContent = author;
        tspan.setAttribute('class', 'curved-author-tspan');
        tspan.addEventListener('click', function (e) {
          if (curvedDragged) return;
          e.stopPropagation();
          selectAuthorFromLoop(author);
        });
        curvedTextPath.appendChild(tspan);

        const sep = document.createElementNS(SVG_NS, 'tspan');
        sep.textContent = '   ✦   ';
        sep.setAttribute('fill', '#99b966');
        curvedTextPath.appendChild(sep);
      });

      let curveOffset = 0;
      let isDraggingCurve = false;
      let curvedDragged = false;
      let dragStartX = 0;
      curvedWrapper.addEventListener('pointerdown', function (e) { isDraggingCurve = true; curvedDragged = false; dragStartX = e.clientX; });
      window.addEventListener('pointermove', function (e) {
        if (!isDraggingCurve) return;
        const dx = e.clientX - dragStartX;
        if (Math.abs(dx) > 4) curvedDragged = true;
        dragStartX = e.clientX;
        curveOffset += dx * 1.4;
      });
      window.addEventListener('pointerup', function () { isDraggingCurve = false; setTimeout(function () { curvedDragged = false; }, 50); });
      function tickCurvedLoop() {
        if (!isDraggingCurve) curveOffset -= 1.4;
        if (curveOffset < -2600) curveOffset += 1300;
        if (curveOffset > 0) curveOffset -= 1300;
        curvedTextPath.setAttribute('startOffset', curveOffset.toFixed(1) + 'px');
        requestAnimationFrame(tickCurvedLoop);
      }
      requestAnimationFrame(tickCurvedLoop);

      // ==================== 6. Book Detail + 3D FlipCard Modal ====================
      const detailModal = document.getElementById('book-detail-modal');
      const modalFlipScene = document.getElementById('modal-flip-scene');
      const modalFlipTilt = document.getElementById('modal-flip-tilt');
      const modalFlipGlare = document.getElementById('modal-flip-glare');
      let currentDetailBook = null;

      modalFlipScene.addEventListener('mousemove', function (e) {
        const r = modalFlipScene.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        modalFlipTilt.style.transform = 'scale(1.03) rotateX(' + ((0.5 - py) * 24).toFixed(1) + 'deg) rotateY(' + ((px - 0.5) * 24).toFixed(1) + 'deg)';
        modalFlipGlare.style.background = 'radial-gradient(circle at ' + (px * 100).toFixed(0) + '% ' + (py * 100).toFixed(0) + '%, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0) 65%)';
      });
      modalFlipScene.addEventListener('mouseleave', function () {
        modalFlipTilt.style.transform = 'scale(1) rotateX(0deg) rotateY(0deg)';
      });
      modalFlipScene.addEventListener('click', function () { modalFlipScene.classList.toggle('is-flipped'); });
      document.getElementById('manual-flip-btn').addEventListener('click', function () { modalFlipScene.classList.toggle('is-flipped'); });

      function openBookDetail(bookId) {
        const book = books.find(b => b.id === bookId);
        if (!book) return;
        currentDetailBook = book;
        modalFlipScene.classList.remove('is-flipped');
        document.getElementById('detail-book-cover').src = book.image;
        document.getElementById('detail-book-title').textContent = book.title;
        document.getElementById('detail-book-author').textContent = book.author;
        document.getElementById('detail-genre-badge').textContent = book.genre || 'Văn học';
        document.getElementById('detail-book-synopsis').textContent = book.synopsis || 'Chưa có văn án.';
        document.getElementById('detail-book-notes').value = book.notes || '';
        document.getElementById('flip-back-title').textContent = book.title;
        document.getElementById('flip-back-author').textContent = book.author;
        document.getElementById('flip-back-genre').textContent = book.genre || 'Văn học';
        document.getElementById('flip-back-synopsis').textContent = book.synopsis || 'Chưa có văn án.';
        document.getElementById('flip-back-rating').textContent = (book.rating || 4) + '/5 ★';

        const meta = STATUS_META[book.status] || STATUS_META.want;
        const badge = document.getElementById('detail-status-badge');
        badge.textContent = meta.label;
        badge.className = 'inline-flex items-center px-3 py-1 rounded-full font-label text-label-sm ' + meta.badgeClass;

        renderDetailStars(book.rating || 4);
        highlightDetailStatus(book.status);
        detailModal.classList.remove('hidden');
      }

      function renderDetailStars(rating) {
        const row = document.getElementById('detail-star-row');
        row.innerHTML = '';
        for (let s = 1; s <= 5; s++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.innerHTML = '<span class="material-symbols-outlined text-[22px] ' + (s <= rating ? 'text-kale-pink' : 'text-light-outline') + '" style="font-variation-settings: \'FILL\' ' + (s <= rating ? 1 : 0) + ';">star</span>';
          btn.addEventListener('click', function () {
            if (currentDetailBook) {
              currentDetailBook.rating = s;
              renderDetailStars(s);
              document.getElementById('flip-back-rating').textContent = s + '/5 ★';
            }
          });
          row.appendChild(btn);
        }
        document.getElementById('detail-rating-text').textContent = rating + '/5';
      }

      function highlightDetailStatus(status) {
        document.querySelectorAll('.detail-status-btn').forEach(function (btn) {
          const active = btn.getAttribute('data-detail-status') === status;
          btn.className = active
            ? 'detail-status-btn px-3 py-1.5 rounded-full font-label text-label-sm bg-light-primary text-light-on-primary'
            : 'detail-status-btn px-3 py-1.5 rounded-full font-label text-label-sm bg-light-surface-container text-light-on-surface';
        });
      }
      document.querySelectorAll('.detail-status-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (currentDetailBook) {
            currentDetailBook.status = btn.getAttribute('data-detail-status');
            highlightDetailStatus(currentDetailBook.status);
          }
        });
      });
      document.getElementById('save-detail-btn').addEventListener('click', function () {
        if (currentDetailBook) {
          currentDetailBook.notes = document.getElementById('detail-book-notes').value;
          saveBooks(books);
        }
        detailModal.classList.add('hidden');
      });
      document.getElementById('close-detail-modal-btn').addEventListener('click', function () {
        detailModal.classList.add('hidden');
      });

      // ==================== 7. Settings & Add Book Modals ====================
      const settingsModal = document.getElementById('settings-modal');
      document.getElementById('open-settings-btn').addEventListener('click', function () { settingsModal.classList.remove('hidden'); });
      document.getElementById('close-settings-btn').addEventListener('click', function () { settingsModal.classList.add('hidden'); });
      document.getElementById('done-settings-btn').addEventListener('click', function () { settingsModal.classList.add('hidden'); });
      document.getElementById('setting-drift-speed').addEventListener('change', function (e) { driftBaseSpeed = parseInt(e.target.value, 10); });

      document.querySelectorAll('.theme-preset-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const preset = btn.getAttribute('data-theme-preset');
          document.querySelectorAll('.theme-preset-btn').forEach(b => b.classList.remove('border-2', 'border-light-primary'));
          btn.classList.add('border-2', 'border-light-primary');
          const t2 = document.getElementById('template-2');
          t2.classList.remove('bg-cream-surface', 'bg-dark-surface', 'text-light-on-surface', 'text-dark-on-surface');
          if (preset === 'plum') {
            t2.classList.add('bg-dark-surface', 'text-dark-on-surface');
          } else {
            t2.classList.add('bg-cream-surface', 'text-light-on-surface');
          }
        });
      });

      const addModal = document.getElementById('add-book-modal');
      document.getElementById('add-book-open-btn').addEventListener('click', function () { addModal.classList.remove('hidden'); });
      document.getElementById('close-add-modal-btn').addEventListener('click', function () { addModal.classList.add('hidden'); });
      document.getElementById('cancel-add-btn').addEventListener('click', function () { addModal.classList.add('hidden'); });
      document.getElementById('add-book-form').addEventListener('submit', function (e) {
        e.preventDefault();
        const title = document.getElementById('new-title').value.trim();
        const author = document.getElementById('new-author').value.trim();
        const genre = document.getElementById('new-genre').value;
        const synopsis = document.getElementById('new-synopsis').value.trim();
        const status = document.getElementById('new-status').value;
        if (!title || !author) return;
        const imgIdx = (books.length % 6) + 1;
        books.unshift({
          id: 'b_' + Date.now(),
          title: title,
          author: author,
          genre: genre,
          rating: 5,
          synopsis: synopsis || 'Cuốn sách mới được lưu vào Hang Chuột Chũi.',
          notes: '',
          image: '../../images/book_cover_' + imgIdx + '.jpg',
          status: status
        });
        saveBooks(books);
        rebuildDriftWall(currentTag);
        e.target.reset();
        addModal.classList.add('hidden');
      });

      // ==================== 8. ClickSpark Global Effect ====================
      const sparkCanvas = document.getElementById('click-spark-canvas');
      if (sparkCanvas) {
        const sctx = sparkCanvas.getContext('2d');
        const sparks = [];
        function resizeSpark() { sparkCanvas.width = window.innerWidth; sparkCanvas.height = window.innerHeight; }
        resizeSpark();
        window.addEventListener('resize', resizeSpark);
        document.addEventListener('click', function (e) {
          const now = performance.now();
          for (let i = 0; i < 8; i++) {
            sparks.push({ x: e.clientX, y: e.clientY, angle: (2 * Math.PI * i) / 8, startTime: now });
          }
        });
        function drawSparks(now) {
          sctx.clearRect(0, 0, sparkCanvas.width, sparkCanvas.height);
          for (let i = sparks.length - 1; i >= 0; i--) {
            const sp = sparks[i];
            const elapsed = now - sp.startTime;
            if (elapsed >= 500) { sparks.splice(i, 1); continue; }
            const p = elapsed / 500;
            const eased = p * (2 - p);
            const dist = eased * 30;
            const len = 14 * (1 - eased);
            sctx.strokeStyle = 'rgba(255, 255, 255, ' + (1 - p).toFixed(2) + ')';
            sctx.lineWidth = 2;
            sctx.lineCap = 'round';
            sctx.beginPath();
            sctx.moveTo(sp.x + dist * Math.cos(sp.angle), sp.y + dist * Math.sin(sp.angle));
            sctx.lineTo(sp.x + (dist + len) * Math.cos(sp.angle), sp.y + (dist + len) * Math.sin(sp.angle));
            sctx.stroke();
          }
          requestAnimationFrame(drawSparks);
        }
        requestAnimationFrame(drawSparks);
      }
    })();
  </script>


</body></html>